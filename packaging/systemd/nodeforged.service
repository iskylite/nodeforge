[Unit]
Description=NodeForge PXE Provisioning Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nodeforge
ExecStartPre=/opt/nodeforge/bin/nodeforged --check
ExecStart=/opt/nodeforge/bin/nodeforged
Restart=on-failure
RestartSec=2s
# TFTP is the fixed privileged UDP/69 service introduced in M1.  Keep the
# capability set minimal; DHCP (CAP_NET_RAW/CAP_NET_BIND_SERVICE) is added in M2.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
