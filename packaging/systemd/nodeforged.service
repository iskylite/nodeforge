[Unit]
Description=NodeForge PXE Provisioning Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_ROOT@
# 启动前执行配置校验；--log-output file 使校验错误写入日志文件而非仅 stdout。
# 校验失败时 systemd 不会启动主进程，避免以无效配置绑定特权端口。
ExecStartPre=@INSTALL_ROOT@/bin/nodeforged --check --log-output file
# 主进程：启动 DHCP/TFTP/HTTP 三合一 PXE 服务。
# --log-output file 将结构化日志写入配置指定的文件路径。
ExecStart=@INSTALL_ROOT@/bin/nodeforged --log-output file
# Restart=always: config reload (node add/set/remove) causes clean exit;
# systemd restarts the daemon to load the new config.json. systemctl stop
# still prevents restart (intentional stop).
Restart=always
RestartSec=2s
# TFTP（UDP 69）和 DHCP（UDP 67）使用特权端口；DHCP 在 OFFER 前发送
# raw ICMP Echo（ping）检测 IP 冲突。CAP_SYS_ADMIN 用于 ISO 导入时的
# 只读 loop mount。这三个 capability 是 daemon 正常运行的最小特权集。
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_ADMIN
NoNewPrivileges=true
# ISO loop mount 是导入器的实现细节；PrivateMounts 确保即使导入过程
# 崩溃或被中断，挂载也不会泄漏到宿主机的 mount namespace 中。
# daemon 重启后所有残留挂载自动回收。
PrivateMounts=true

[Install]
WantedBy=multi-user.target
