{
  "schema_version": 1,
  "server": {
    "name": "nodeforge-dev",
    "bind_interface": "enp1s0",
    "server_ip": "192.168.50.1",
    "http_port": 8080
  },
  "http": {
    "asset_root": "/opt/nodeforge/assets",
    "repository_root": "/opt/nodeforge/repos"
  },
  "tftp": {
    "asset_root": "/opt/nodeforge/tftp"
  },
  "dhcp": {
    "subnet": "192.168.50.0/24",
    "pool_start": "192.168.50.100",
    "pool_end": "192.168.50.200",
    "router": "192.168.50.1",
    "dns": ["192.168.50.1"],
    "lease_seconds": 1800,
    "offer_seconds": 60,
    "abandon_seconds": 3600,
    "ping_timeout_ms": 500
  },
  "logging": {
    "level": "info"
  },
  "events": {
    "max_size_mb": 100,
    "keep": 5
  },
  "distros": [
    {
      "name": "rocky",
      "family": "rhel",
      "versions": [
        {
          "version": "9.7",
          "archs": ["aarch64", "x86_64"],
          "install_adapter": "kickstart",
          "package_manager": "dnf"
        },
        {
          "version": "8.10",
          "archs": ["aarch64", "x86_64"],
          "install_adapter": "kickstart",
          "package_manager": "dnf"
        }
      ]
    },
    {
      "name": "ubuntu",
      "family": "ubuntu",
      "versions": [
        {
          "version": "22.04",
          "archs": ["aarch64", "x86_64"],
          "install_adapter": "autoinstall",
          "package_manager": "apt"
        }
      ]
    }
  ],
  "policy": {
    "default_action": "wait",
    "allow_unknown_diskless": false
  }
}
