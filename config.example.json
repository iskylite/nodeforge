    "dns": [
      "192.168.50.1"
    ],
    "lease_seconds": 1800,
    "offer_seconds": 60,
    "abandon_seconds": 3600,
    "ping_timeout_ms": 100,
    "max_leases": null
  },
  "capacity": {
    "managed_entries": null
  },
  "logging": {
    "level": "info"
  },
  "events": {
    "max_size_mb": 100,
    "keep": 5
